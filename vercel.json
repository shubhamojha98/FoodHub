{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/resturant/:restaurantId", "destination": "/index.html" },
    { "source": "/restaurant/:restaurantId", "destination": "/index.html" },
    { "source": "/cart", "destination": "/index.html" },
    { "source": "/about", "destination": "/index.html" },
    { "source": "/contact", "destination": "/index.html" },
    { "source": "/grocery", "destination": "/index.html" }
  ]
}
